# From Supabase: Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Backups only (npm run backup). Supabase dashboard -> Connect -> Direct ->
# Session pooler; replace [YOUR-PASSWORD] with the database password. Vite only
# exposes VITE_-prefixed variables, so this never reaches the browser bundle.
# Use the session pooler, not the direct connection: direct is IPv6-only unless
# you pay for the IPv4 add-on.
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT:YOUR-DB-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Optional but better: Database settings -> SSL configuration -> Download
# certificate, then point at it so the server is verified, not just encrypted.
# SUPABASE_DB_CA=C:\path\to\prod-ca-2021.crt

# Where backups are written. The default is ../rapidewms-backups, outside this
# repository on purpose: this repo is public.
# BACKUP_DIR=E:\rapidewms-backups
